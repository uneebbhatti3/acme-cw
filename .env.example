# Shows the "Design preview" badge and demo notes
NEXT_PUBLIC_DEMO_MODE=true
# Public site URL, used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://acme-cw.vercel.app

# Neon Postgres. `neon env pull` writes this to .env.local; add it to Vercel for deployments
DATABASE_URL=

# Neon Object Storage. `neon env pull` writes these to .env.local; add them to Vercel for deployments
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Neon Auth. `neon deploy` writes the first two; generate the secret with `openssl rand -base64 32`
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=

# Outgoing email through nodemailer, for catalogue download codes
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, such as "Acme Commercial Ways <sales@example.com>". Defaults to the company name with SMTP_USER
MAIL_FROM=
# Who gets a notice of each catalogue request. Defaults to the first address in site.ts
CATALOGUE_NOTIFY_EMAIL=
# Signs download codes and links. Generate with `openssl rand -base64 32`
CATALOGUE_SECRET=
